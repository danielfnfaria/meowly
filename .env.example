# Every setting comes from the environment, prefix MEOWLY_ (pydantic-settings).
# Copy to .env only for local experiments; compose.yaml sets what `make up` needs.

MEOWLY_DATABASE_URL=postgresql+asyncpg://meowly@localhost:5432/meowly
MEOWLY_LOG_LEVEL=INFO

# Where the API serves (ServerSettings; the API defaults to 8000, other processes to 8080).
MEOWLY_HOST=0.0.0.0
MEOWLY_PORT=8000

# How tasks are launched: `kubernetes` (a PlatformTask per request) or `memory` (no cluster).
MEOWLY_LAUNCHER=memory
MEOWLY_EXECUTION_NAMESPACE=meowly
