# Every setting comes from the environment, prefix PURR_ (pydantic-settings).
# Copy to .env only for local experiments; compose.yaml sets what `make up` needs.

PURR_DATABASE_URL=postgresql+asyncpg://purr@localhost:5432/purr
PURR_LOG_LEVEL=INFO

# Where the API serves (ServerSettings; the API defaults to 8000, other processes to 8080).
PURR_HOST=0.0.0.0
PURR_PORT=8000

# How tasks are launched: `kubernetes` (a PlatformTask per request) or `memory` (no cluster).
PURR_LAUNCHER=memory
PURR_EXECUTION_NAMESPACE=purr
PURR_WORKER_IMAGE=purr-worker:dev
